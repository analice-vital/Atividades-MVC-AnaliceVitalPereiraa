@model IEnumerable<FuncionariosMVC.Models.Funcionario>
<h2>Dashboard</h2><p>Total: @Model.Count()</p><p>Ativos: @Model.Count(x=>x.Ativo)</p><p>Inativos: @Model.Count(x=>!x.Ativo)</p><p>Média salarial: R$ @Model.Average(x=>x.Salario).ToString("F2")</p><p>Maior salário: R$ @Model.Max(x=>x.Salario)</p><p>Menor salário: R$ @Model.Min(x=>x.Salario)</p><h3>Por departamento</h3>@foreach(var g in Model.GroupBy(x=>x.Departamento)){<p>@g.Key: @g.Count()</p>}