@model IEnumerable<EstoqueMVC.Models.Produto>
<h2>Estoque</h2><table><tr><th>Produto</th><th>Categoria</th><th>Estoque</th><th>Mínimo</th><th>Preço</th></tr>@foreach(var p in Model){<tr><td>@p.Nome</td><td>@p.Categoria</td><td>@p.Estoque</td><td>@p.EstoqueMinimo</td><td>R$ @p.Preco</td></tr>}</table>